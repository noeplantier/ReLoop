# Copy to backend/.env (never commit .env). Values go straight into the hosting dashboard, never into chat or git.

# Preferred: read-only role limited to the 5 ReLoop tables (migration 0005). Use the Supabase
# pooler string from the dashboard's "Connect" dialog, with user reloop_reader.<project-ref>.
DATABASE_URL=

# Fallback only (used when DATABASE_URL is empty). Bypasses RLS and can read EVERY table in the
# shared project. Backend only: never in the web app, never committed, never logged.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
